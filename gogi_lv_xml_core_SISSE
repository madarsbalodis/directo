if @what = 'invoice'
    begin
	declare @InvoiceNumber nvarchar(32), @invoiceDate datetime, @salesOrder nvarchar(32), @customerId nvarchar(32), @directoSalesOrderNumber int

        DECLARE invoice CURSOR FOR SELECT number,invoiceDate,orderNumber,CustomerId from in_mr_arved where x=@xkey and session_id=@session_id
		OPEN invoice
            FETCH NEXT FROM invoice INTO @InvoiceNumber, @invoiceDate,@salesOrder,@customerId
            WHILE @@FETCH_STATUS = 0
            BEGIN
			select @customerId = kaart from yld_data where kood='CUSTOMERID' and					klass='Klient' and sisu=convert(nvarchar(max),@customerId)
				if (select count(*) from mr_arved where lisa_field1=convert(nvarchar(max),@InvoiceNumber)) >=1
					begin
						INSERT INTO #results VALUES ( NULL, 'Invoice', 11, 'Duplicate', 'Invoices', @InvoiceNumber)
					end
				else
					begin
						if (select count(*) from tell_tellimused where kliendi_tellimus=convert(nvarchar(max),@salesOrder))=0
							begin
								INSERT INTO #results VALUES ( NULL, 'Invoice', 11, 'Order '+convert(nvarchar(max),@salesOrder)+' not exsists', 'Invoices', @InvoiceNumber)
							end
						else
							begin
								select @directoSalesOrderNumber = number from tell_tellimused where kliendi_tellimus=convert(nvarchar(max),@salesOrder)
									
									if (select count(*) from mr_laekumised where number in (select number from mr_laekumised_read where ettemaks=@directoSalesOrderNumber) and isnull(kinnitatud,0)=1)=0
										begin
											INSERT INTO #results VALUES ( NULL, 'Invoice', 11, 'Payment for order '+convert(nvarchar(max),@salesOrder)+' not received', 'Invoices', @InvoiceNumber)
										end
									else
										begin
											

											select @defCustomer = param1, @defStock=param2 from tr_params where tyyp='xmlcore' and kood='order'

											if (select klient_kood from tell_tellimused where number=@directoSalesOrderNumber)!=isnull(@customerId,@defCustomer)
												begin
													INSERT INTO #results VALUES ( NULL, 'Invoice', 11, 'Order '+convert(nvarchar(max),@salesOrder)+' contain different customer', 'Invoices', @InvoiceNumber)
												end
											else
												begin
													EXEC dbo.get_dok_number @moodul='arve', @seeria='DOC2024', @NUMBER = NULL, @cu='xmlcore', @aeg=@ag, @keel = 'default', @num =@number OUTPUT, @err = @err OUTPUT

													update mr_arved set lisa_field1=convert(nvarchar(max),@InvoiceNumber) where number=@number
													INSERT INTO #results VALUES ( NULL, 'Invoice', 1, 'OK', 'Invoices', @InvoiceNumber)

													update mr_arved set
														tingimus=isnull(z.tingimus,'0'),
														maa=z.maa,
														klient_kood=z.klient_kood,
														klient_nimi=z.klient_nimi,
														aadress1=z.aadress1,
														aadress2=z.aadress2,
														aadress3=z.aadress3,
														myyja=iif(isnull(z.myyja,'')='','XML',z.myyja),
														ladu=z.ladu,
														kmregnumber=z.kmregnumber,
														telefon=z.telefon,
														asumaa=z.asumaa,
														ettemaks=z.ettemaks,
														klientnimi_lahetusel=z.klient_nimi_lahetusel,
														lahetusaadress1=z.lahetusaadress1,
														lahetusaadress2=z.lahetusaadress3,
														lahetusaadress3=z.lahetusaadress3,
														muudaladu=1,
														valuuta='EUR',
														kurssBV1=1,
														kommentaar=z.kommentaar,
														tellimusenr=@directoSalesOrderNumber,
														klienditellimus=@salesOrder,
														aeg=@invoiceDate
														from
													(select * from tell_tellimused where number=@directoSalesOrderNumber) z
													where mr_arved.number=@number

													update mr_arved set ettemaks=isnull((select sum(summa_p) from mr_laekumised_read where mr_laekumised_read.ettemaks=@directoSalesOrderNumber),0) where number=@number
													update mr_arved set aeg2=cast(dateadd(d,isnull((select netopaevi from mr_tasumistingimused where kood=mr_arved.tingimus),0),mr_arved.aeg)as date) where number=@number

													declare @maa int
													select @maa = maa from kliendid where kood=isnull(@customerId,@defCustomer)
													insert mr_arved_read (number, kogus,artikkel,seletus, hind, summa, kmk, konto)
													select @number,quantity,item,linedescription,price,price * quantity, dbo.get_art_kmkood(item,@maa),dbo.get_art_konto(item,@maa) from in_mr_arved_read where session_id=@session_id and x=@xkey

													select @ts

													exec dbo.mr_arved_renum @number
													exec dbo.arvuta_arve @number
													exec dbo.kinnita_arve @number,'XML',@ts

												end

										end


							end
						
					end


			    FETCH NEXT FROM invoice INTO @InvoiceNumber, @invoiceDate,@salesOrder,@customerId
            END
            CLOSE invoice
            DEALLOCATE invoice
    end



	select * from in_mr_arved

IF ( SELECT COUNT(*) FROM #results ) = 0
	INSERT INTO #results VALUES ( NULL, 'GENERAL ERROR', 99, 'No processable XML data found for document: ' + @what, NULL, NULL ) 
/* results out */
SELECT @result1 =
	( SELECT result AS "@type", descr AS "@desc", number AS "@docid", ext_id AS "@ext_id", tyyp AS "@doctype", submittype AS "@submit"
FROM #results FOR XML PATH ( 'result' ) )
SET @result2 = '<?xml version="1.0" encoding="UTF-8"?><results>' + CONVERT( nvarchar(max), @result1 ) + '</results>'

IF EXISTS ( SELECT result FROM #results WHERE result != 0 )
	INSERT INTO in_xml_errors ( ts_inserted, ts_processed, what, dat_xml ) VALUES ( @ts, GETDATE(), @what, @result2 )

IF @test != 1
	SELECT @result2

/* test results out */
ELSE
BEGIN
	SET @result2 = '<html></br>&ltresults></br>' + REPLACE( REPLACE( CONVERT( nvarchar(max), @result1 ), '<', '&lt' ), '/>&ltresult', '/> </br> &ltresult' ) + '</br>&lt/results></br></br>'
	SELECT @result2 + @testresults + '</html>'
END



DROP TABLE #results
DROP TABLE #output

