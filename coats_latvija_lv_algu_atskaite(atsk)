<xsl:stylesheet version="1.0"
xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
xmlns:fo="http://www.w3.org/1999/XSL/Format"
xmlns:msxsl="urn:schemas-microsoft-com:xslt"
xmlns:js="urn:formulas"
exclude-result-prefixes="msxsl js fo">
<xsl:output method="html"/>
<xsl:template match="/">
<head>
<link href="https://fonts.googleapis.com/css?family=Arsenal|Cuprum|Open+Sans+Condensed:300|Ubuntu+Condensed&amp;subset=cyrillic,cyrillic-ext,latin-ext" rel="stylesheet" />
</head>
   <xsl:variable name="item_per_first_page">6</xsl:variable>
   <xsl:variable name="item_per_other_pages">6</xsl:variable>
   <xsl:variable name="chars_per_row">25</xsl:variable>
   
    <xsl:variable name="avansi">
        <avansi>
    <xsl:for-each select="//tasumised/tasumine/valemid/valem[@klass='AVANSS']">
        <avanss>
        <persona><xsl:value-of select="../../persoon"/></persona>
        <summa><xsl:value-of select="format-number(neto, '0.00')"/></summa>
        </avanss>
    </xsl:for-each>
    </avansi>
            </xsl:variable>
               <xsl:variable name="ietur">
       <ieturejumi>
            <xsl:for-each select="/documents/document/valemid/valem[@klass='ATVILKUMS']"> <!--  <xsl:for-each select="//tasumised/tasumine/valemid/valem[@klass='ATVILKUMS']">-->
        <ieturejums>
        <persona><xsl:value-of select="../../persoon"/></persona>
        <summa><xsl:value-of select="format-number(neto, '0.00')"/></summa>
        </ieturejums>
        
    </xsl:for-each>
    </ieturejumi>
            </xsl:variable>


    
    
   <xsl:variable name="pages_count">
    <xsl:choose>
     <xsl:when test="(/documents/document/ridu&lt;$item_per_first_page) or (/documents/document/ridu=$item_per_first_page)">1</xsl:when>
     <xsl:otherwise><xsl:value-of select="ceiling(((/documents/document/ridu)-($item_per_first_page)) div $item_per_other_pages)+1" /></xsl:otherwise>
    </xsl:choose>
   </xsl:variable>
    <style>
    .main table tr td {font-size:8pt; font-family:Arsenal;}
           .pbreak {
    page-break-after:always;
    }
        </style> 
    <html>
    
    
        <head>
            <title>Algas lapiņas</title>
        </head>
        <body>
