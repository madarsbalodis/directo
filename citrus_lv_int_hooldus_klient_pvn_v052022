        ELSE CAST((oae.summa / (1 + isnull((select rate from @pvn11_vat_codes where code=oae.kmk),@stat_vat) / 100)) AS decimal(15,2)) - isnull(cast((select sum(summa) from or_arved_read oar where oar.number=oae.arve and oar.kmkood = oae.kmk) as decimal(15,2)),0)
    END) AS doc_sum,
    (CASE
