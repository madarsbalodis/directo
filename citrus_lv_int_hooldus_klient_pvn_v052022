  SELECT pazime, vat_reg_nr, doc_nr, SUM(article_sum) FROM @invoices GROUP BY vat_reg_nr, pazime, doc_nr


  SELECT pazime, vat_reg_nr, CAST(SUM(article_sum) AS decimal(15,2)) AS sum
